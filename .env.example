# Configuración de Base de Datos
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=minrel03_sac
DB_USERNAME=root
DB_PASSWORD=

# API Key para autenticación
BIOGAZE_API_KEY=minrel-biogaze-secret-key-2025

# Puerto de la API
BIOGAZE_PORT=8000

# Configuración de AWS S3 / Linode Object Storage
# Habilitar/deshabilitar almacenamiento en S3 (true/false)
S3_ENABLED=true
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-mia-1
S3_BUCKET_NAME=your_bucket_name_here
AWS_ENDPOINT_URL=us-mia-1.linodeobjects.com

# Detener validaciones al primer error (false para recopilar todos)
EARLY_STOP_ENABLED=false

# Chequeos de resolución y proporción
MIN_WIDTH=413
MIN_HEIGHT=531
ASPECT_RATIO=7:9
# Margen permitido para la relación de aspecto (valor absoluto)
ASPECT_RATIO_THRESHOLD=0.03
# Omite chequeo de resolución/ratio (false por defecto)
SKIP_RESOLUTION_CHECK=false
SKIP_RATIO_CHECK=false

# Visual Language Model (VLM) settings
# Toggle to disable VLM checks: set to false/0/no
VLM_ENABLED=true
VLM_ENDPOINT=http://localhost:8000/
VLM_API_KEY=
VLM_MODEL_NAME=Qwen3-VL
VLM_REQUEST_TIMEOUT=120
VLM_MAX_TOKENS=4
VLM_TEMPERATURE=0
VLM_MAX_CONCURRENCY=4
